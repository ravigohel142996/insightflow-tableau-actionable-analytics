<?xml version="1.0" encoding="utf-8"?>
<!-- Tableau Extension Manifest for InsightFlow - Actionable Analytics -->
<!-- This manifest defines extension metadata and security permissions -->
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.insightflow.actionable-analytics" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Actionable Analytics for Tableau Cloud</description>
    <author name="InsightFlow" email="support@insightflow.io" organization="InsightFlow" website="https://insightflow.io"/>
    
    <!-- Minimum Tableau Extensions API version required -->
    <min-api-version>1.0</min-api-version>
    
    <!-- Source location uses HTTPS for Tableau Cloud compatibility -->
    <!-- GitHub Pages provides free HTTPS hosting for static extensions -->
    <source-location>
      <url>https://ravigohel142996.github.io/insightflow-tableau-actionable-analytics/</url>
    </source-location>
    
    <!-- Icon placeholder - base64 encoded image would be embedded here -->
    <icon>
      <!-- Base64 encoded icon would go here in production -->
    </icon>
    
    <!-- Full data access required to read dashboard metrics -->
    <!-- This permission allows the extension to access worksheet data -->
    <permissions>
      <permission>full data</permission>
    </permissions>
  </dashboard-extension>
  
  <resources>
    <resource id="name">
      <text locale="en_US">InsightFlow - Actionable Analytics</text>
    </resource>
  </resources>
</manifest>
